// =============================================================================
// Misfit — Prisma Schema
// Database: Neon PostgreSQL ONLY
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum RoleName {
  FOUNDER
  FREELANCER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  PENDING_APPROVAL
}

enum StartupStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum Industry {
  FINTECH
  HEALTHTECH
  EDTECH
  ECOMMERCE
  SAAS
  AI_ML
  MARKETPLACE
  SOCIAL
  CLIMATE
  OTHER
}

enum ServiceType {
  DEVELOPMENT_PARTNER
  TECHNICAL_COFOUNDER
  AI_CONSULTING
  COMPANY_REGISTRATION
  FREELANCER_HIRE
  FULL_STACK_BUILD
  MVP
  UI_UX
  OTHER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentType {
  PITCH_DECK
  BUSINESS_PLAN
  FINANCIALS
  PAN
  GST
  STARTUP_INDIA
  TRADEMARK
  INCORPORATION
  RESUME
  PORTFOLIO
  CONTRACT
  INVOICE
  OTHER
}

enum DocumentOwnerType {
  USER
  STARTUP
  PROJECT
  COMPANY_REGISTRATION
  FREELANCER
  SUPPORT_TICKET
}

enum CompanyRegType {
  PAN
  GST
  STARTUP_INDIA
  TRADEMARK
  PRIVATE_LIMITED
  LLP
  OPC
  PARTNERSHIP
  OTHER
}

enum CompanyRegStatus {
  DRAFT
  SUBMITTED
  DOCUMENTS_PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  PART_TIME
  UNAVAILABLE
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  ACTIVE
  COMPLETED
  REJECTED
  CANCELLED
}

enum NotificationType {
  SYSTEM
  PROJECT
  PAYMENT
  MEETING
  DOCUMENT
  ASSIGNMENT
  SUPPORT
  SECURITY
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum MeetingType {
  DISCOVERY
  CONSULTATION
  PROJECT_SYNC
  TECHNICAL_COFOUNDER
  SUPPORT
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentType {
  PROJECT
  INVOICE
  FREELANCER_PAYOUT
  SUBSCRIPTION
  CONSULTATION
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_RESET
  EMAIL_VERIFY
  ROLE_CHANGE
  STATUS_CHANGE
  FILE_UPLOAD
  FILE_DELETE
  PAYMENT
  OTHER
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
  CANCELLED
}

enum ConsultationStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

// -----------------------------------------------------------------------------
// Auth & Identity
// -----------------------------------------------------------------------------

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  roleId          String
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  role Role @relation(fields: [roleId], references: [id])

  profile              Profile?
  freelancer           Freelancer?
  refreshTokens        RefreshToken[]
  emailVerifications   EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  startups             Startup[]                @relation("StartupFounder")
  ownedProjects        Project[]                @relation("ProjectOwner")
  assignedTasks        Task[]                   @relation("TaskAssignee")
  createdTasks         Task[]                   @relation("TaskCreator")
  comments             Comment[]
  documents            Document[]               @relation("DocumentUploader")
  companyRegistrations CompanyRegistration[]
  notifications        Notification[]
  meetingsOrganized    Meeting[]                @relation("MeetingOrganizer")
  meetingParticipants  MeetingParticipant[]
  payments             Payment[]                @relation("PaymentPayer")
  invoices             Invoice[]                @relation("InvoiceCustomer")
  supportTickets       SupportTicket[]          @relation("TicketRequester")
  assignedTickets      SupportTicket[]          @relation("TicketAssignee")
  blogPosts            Blog[]
  auditLogs            AuditLog[]
  consultations        Consultation[]

  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  displayName String?
  avatarUrl   String?
  phone       String?
  bio         String?  @db.Text
  companyName String?
  website     String?
  linkedinUrl String?
  twitterUrl  String?
  location    String?
  timezone    String?  @default("UTC")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// Startups & Projects
// -----------------------------------------------------------------------------

model Startup {
  id               String        @id @default(cuid())
  founderId        String
  name             String
  slug             String        @unique
  tagline          String?
  industry         Industry
  description      String        @db.Text
  budgetMin        Decimal?      @db.Decimal(12, 2)
  budgetMax        Decimal?      @db.Decimal(12, 2)
  currency         String        @default("USD")
  timelineWeeks    Int?
  requiredServices ServiceType[]
  status           StartupStatus @default(DRAFT)
  website          String?
  pitchDeckUrl     String?
  rejectionReason  String?       @db.Text
  reviewedAt       DateTime?
  reviewedById     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  founder              User                  @relation("StartupFounder", fields: [founderId], references: [id])
  projects             Project[]
  documents            Document[]
  companyRegistrations CompanyRegistration[]
  consultations        Consultation[]
  meetings             Meeting[]

  @@index([founderId])
  @@index([status])
  @@index([industry])
  @@index([deletedAt])
  @@map("startups")
}

model Project {
  id          String        @id @default(cuid())
  startupId   String?
  ownerId     String
  name        String
  slug        String        @unique
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  progress    Int           @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  startup     Startup?     @relation(fields: [startupId], references: [id])
  owner       User         @relation("ProjectOwner", fields: [ownerId], references: [id])
  tasks       Task[]
  milestones  Milestone[]
  documents   Document[]
  comments    Comment[]
  assignments Assignment[]
  meetings    Meeting[]
  payments    Payment[]
  invoices    Invoice[]

  @@index([startupId])
  @@index([ownerId])
  @@index([status])
  @@index([deletedAt])
  @@map("projects")
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([status])
  @@map("milestones")
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  milestoneId String?
  creatorId   String
  assigneeId  String?
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  creator   User       @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee  User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  comments  Comment[]

  @@index([projectId])
  @@index([milestoneId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@map("tasks")
}

model Comment {
  id        String    @id @default(cuid())
  projectId String
  taskId    String?
  authorId  String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId])
  @@index([taskId])
  @@index([authorId])
  @@map("comments")
}

// -----------------------------------------------------------------------------
// Documents
// -----------------------------------------------------------------------------

model Document {
  id           String            @id @default(cuid())
  uploaderId   String
  ownerType    DocumentOwnerType
  ownerId      String
  startupId    String?
  projectId    String?
  companyRegId String?
  freelancerId String?
  type         DocumentType      @default(OTHER)
  name         String
  originalName String
  mimeType     String
  sizeBytes    Int
  cloudinaryId String?
  url          String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  uploader            User                 @relation("DocumentUploader", fields: [uploaderId], references: [id])
  startup             Startup?             @relation(fields: [startupId], references: [id], onDelete: SetNull)
  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  companyRegistration CompanyRegistration? @relation(fields: [companyRegId], references: [id], onDelete: SetNull)
  freelancer          Freelancer?          @relation(fields: [freelancerId], references: [id], onDelete: SetNull)

  @@index([uploaderId])
  @@index([ownerType, ownerId])
  @@index([startupId])
  @@index([projectId])
  @@index([companyRegId])
  @@index([type])
  @@map("documents")
}

// -----------------------------------------------------------------------------
// Company Registration
// -----------------------------------------------------------------------------

model CompanyRegistration {
  id              String           @id @default(cuid())
  userId          String
  startupId       String?
  type            CompanyRegType
  legalName       String
  tradeName       String?
  panNumber       String?
  gstNumber       String?
  cinNumber       String?
  trademarkNumber String?
  startupIndiaId  String?
  status          CompanyRegStatus @default(DRAFT)
  notes           String?          @db.Text
  adminNotes      String?          @db.Text
  submittedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  user      User       @relation(fields: [userId], references: [id])
  startup   Startup?   @relation(fields: [startupId], references: [id])
  documents Document[]

  @@index([userId])
  @@index([startupId])
  @@index([status])
  @@index([type])
  @@map("company_registrations")
}

// -----------------------------------------------------------------------------
// Freelancers
// -----------------------------------------------------------------------------

model Freelancer {
  id              String             @id @default(cuid())
  userId          String             @unique
  headline        String?
  bio             String?            @db.Text
  hourlyRate      Decimal?           @db.Decimal(10, 2)
  currency        String             @default("USD")
  yearsExperience Int?
  resumeUrl       String?
  portfolioUrl    String?
  availability    AvailabilityStatus @default(AVAILABLE)
  isVerified      Boolean            @default(false)
  rating          Decimal?           @db.Decimal(3, 2)
  totalProjects   Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills      FreelancerSkill[]
  experiences FreelancerExperience[]
  portfolio   PortfolioItem[]
  assignments Assignment[]
  documents   Document[]
  payments    Payment[]              @relation("FreelancerPayments")

  @@index([availability])
  @@index([isVerified])
  @@map("freelancers")
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  freelancers FreelancerSkill[]

  @@map("skills")
}

model FreelancerSkill {
  id           String @id @default(cuid())
  freelancerId String
  skillId      String
  proficiency  Int    @default(3) // 1–5

  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, skillId])
  @@index([skillId])
  @@map("freelancer_skills")
}

model FreelancerExperience {
  id           String    @id @default(cuid())
  freelancerId String
  company      String
  title        String
  description  String?   @db.Text
  startDate    DateTime
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([freelancerId])
  @@map("freelancer_experiences")
}

model PortfolioItem {
  id           String   @id @default(cuid())
  freelancerId String
  title        String
  description  String?  @db.Text
  projectUrl   String?
  imageUrl     String?
  technologies String[]
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([freelancerId])
  @@map("portfolio_items")
}

model Assignment {
  id           String           @id @default(cuid())
  projectId    String
  freelancerId String
  status       AssignmentStatus @default(PENDING)
  roleTitle    String?
  rate         Decimal?         @db.Decimal(10, 2)
  currency     String           @default("USD")
  startDate    DateTime?
  endDate      DateTime?
  notes        String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([projectId, freelancerId])
  @@index([status])
  @@map("assignments")
}

// -----------------------------------------------------------------------------
// Notifications, Meetings, Payments
// -----------------------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  title     String
  body      String           @db.Text
  link      String?
  metadata  Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Meeting {
  id          String        @id @default(cuid())
  organizerId String
  startupId   String?
  projectId   String?
  title       String
  description String?       @db.Text
  type        MeetingType   @default(OTHER)
  status      MeetingStatus @default(SCHEDULED)
  scheduledAt DateTime
  durationMin Int           @default(30)
  meetingUrl  String?
  location    String?
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  organizer    User                 @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  startup      Startup?             @relation(fields: [startupId], references: [id])
  project      Project?             @relation(fields: [projectId], references: [id])
  participants MeetingParticipant[]

  @@index([organizerId])
  @@index([scheduledAt])
  @@index([status])
  @@map("meetings")
}

model MeetingParticipant {
  id        String    @id @default(cuid())
  meetingId String
  userId    String
  joinedAt  DateTime?
  createdAt DateTime  @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@map("meeting_participants")
}

model Payment {
  id           String        @id @default(cuid())
  payerId      String
  freelancerId String?
  projectId    String?
  invoiceId    String?
  type         PaymentType   @default(OTHER)
  status       PaymentStatus @default(PENDING)
  amount       Decimal       @db.Decimal(12, 2)
  currency     String        @default("USD")
  provider     String?
  providerRef  String?
  description  String?
  paidAt       DateTime?
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  payer      User        @relation("PaymentPayer", fields: [payerId], references: [id])
  freelancer Freelancer? @relation("FreelancerPayments", fields: [freelancerId], references: [id])
  project    Project?    @relation(fields: [projectId], references: [id])
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id])

  @@index([payerId])
  @@index([freelancerId])
  @@index([projectId])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id            String        @id @default(cuid())
  customerId    String
  projectId     String?
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @default("USD")
  dueDate       DateTime?
  issuedAt      DateTime?
  paidAt        DateTime?
  notes         String?       @db.Text
  lineItems     Json
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer User      @relation("InvoiceCustomer", fields: [customerId], references: [id])
  project  Project?  @relation(fields: [projectId], references: [id])
  payments Payment[]

  @@index([customerId])
  @@index([projectId])
  @@index([status])
  @@map("invoices")
}

// -----------------------------------------------------------------------------
// Support, Blogs, Audit, Consultations
// -----------------------------------------------------------------------------

model SupportTicket {
  id          String                @id @default(cuid())
  requesterId String
  assigneeId  String?
  subject     String
  description String                @db.Text
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  category    String?
  resolvedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  requester User  @relation("TicketRequester", fields: [requesterId], references: [id])
  assignee  User? @relation("TicketAssignee", fields: [assigneeId], references: [id])

  @@index([requesterId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

model Blog {
  id          String     @id @default(cuid())
  authorId    String
  title       String
  slug        String     @unique
  excerpt     String?
  content     String     @db.Text
  coverImage  String?
  status      BlogStatus @default(DRAFT)
  publishedAt DateTime?
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([status])
  @@map("blogs")
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Consultation {
  id          String             @id @default(cuid())
  userId      String
  startupId   String?
  topic       String
  description String             @db.Text
  status      ConsultationStatus @default(REQUESTED)
  preferredAt DateTime?
  scheduledAt DateTime?
  notes       String?            @db.Text
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  startup Startup? @relation(fields: [startupId], references: [id])

  @@index([userId])
  @@index([startupId])
  @@index([status])
  @@map("consultations")
}
